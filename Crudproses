// ============ SHARED HELPERS ============

function getProsesSH_(sheetName) {
  var sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(sheetName);
  if (!sheet) return { sheet: null, headers: [] };
  var headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
  return { sheet: sheet, headers: headers };
}

/**
 * FIX: Auto-create sheet with default headers if not exists
 */
function ensureProsesSH_(sheetName, defaultHeaders) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName(sheetName);
  if (sheet) {
    var headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
    return { sheet: sheet, headers: headers };
  }
  // Auto-create
  sheet = ss.insertSheet(sheetName);
  sheet.getRange(1, 1, 1, defaultHeaders.length).setValues([defaultHeaders]);
  sheet.getRange(1, 1, 1, defaultHeaders.length).setFontWeight('bold');
  sheet.setFrozenRows(1);
  Logger.log('Auto-created sheet: ' + sheetName + ' with ' + defaultHeaders.length + ' columns');
  return { sheet: sheet, headers: defaultHeaders };
}

/**
 * FIX: Timestamp+random ID instead of sequential counter
 */
function genProsesId_(prefix, sheet) {
  var now = new Date();
  var tz = Session.getScriptTimeZone();
  return prefix + Utilities.formatDate(now, tz, 'yyyyMMddHHmmss') + '-' + Math.floor(Math.random() * 900 + 100);
}

function sanitizeProsesRow_(headers, data) {
  var row = [];
  for (var i = 0; i < headers.length; i++) {
    var key = headers[i];
    row.push(data.hasOwnProperty(key) ? data[key] : '');
  }
  return row;
}

function readProsesGeneric_(sheetName, options) {
  try {
    var info = getProsesSH_(sheetName);
    if (!info.sheet || info.sheet.getLastRow() <= 1) return { success: true, records: [], total: 0 };
    var allData = info.sheet.getDataRange().getValues();
    var tz = Session.getScriptTimeZone();
    var page = (options && options.page) || 1;
    var limit = (options && options.limit) || 15;
    var filterShift = options && options.shift;
    var filterStartDate = (options && options.startDate) || '';
    var filterEndDate = (options && options.endDate) || '';

    var records = [];
    for (var i = allData.length - 1; i >= 1; i--) {
      var obj = {};
      for (var j = 0; j < info.headers.length; j++) {
        var val = allData[i][j];
        if (val instanceof Date) {
          obj[info.headers[j]] = (info.headers[j] === 'tanggal')
            ? Utilities.formatDate(val, tz, 'yyyy-MM-dd')
            : Utilities.formatDate(val, tz, 'yyyy-MM-dd HH:mm:ss');
        } else {
          obj[info.headers[j]] = val;
        }
      }
      if (filterShift && String(obj.shift) !== String(filterShift)) continue;
      if (filterStartDate || filterEndDate) {
        var rd = String(obj.tanggal || '');
        if (filterStartDate && rd < filterStartDate) continue;
        if (filterEndDate && rd > filterEndDate) continue;
      }
      records.push(obj);
    }

    var total = records.length;
    var totalPages = Math.ceil(total / limit);
    var start = (page - 1) * limit;
    return { success: true, records: records.slice(start, start + limit), total: total, page: page, totalPages: totalPages };
  } catch (e) { return { success: false, message: 'Gagal memuat: ' + e.message, records: [] }; }
}

