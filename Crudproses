    'p07_ph','p07_visual_flokulasi','p07_visual_air','p07_batch_lumpur',
    'p12_rotameter','p12_flowmeter','p12_stroke_naoh','p12_stroke_hidroflok','p12_stroke_superflok',
    'p12_ph','p12_visual_flokulasi','p12_visual_air','p12_batch_lumpur',
