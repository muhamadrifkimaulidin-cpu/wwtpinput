    'p03_ph','p03_visual_flokulasi','p03_visual_air','p03_batch_lumpur',
    'catatan'
  ];
}

/**
 * FIX: Uses ensureProsesSH_ to auto-create sheet if missing
 */
function createProsesClarifier(data) {
  try {
    var info = ensureProsesSH_('DataProsesClarifier', getFIKHeaders_());
    var recordId = genProsesId_('FIK-', info.sheet);
    data.record_id = recordId;
    data.timestamp = new Date().toISOString();
    info.sheet.appendRow(sanitizeProsesRow_(info.headers, data));
    return { success: true, message: 'Data FIK berhasil disimpan.', record_id: recordId };
  } catch (e) {
    Logger.log('createProsesClarifier error: ' + e.message + '\n' + e.stack);
    return { success: false, message: 'Gagal: ' + e.message };
  }
}

function readProsesClarifier(options) {
  return readProsesGeneric_('DataProsesClarifier', options);
}

